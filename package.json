{
  "name": "xinghe-zhihui",
  "version": "2.0.46",
  "description": "Desktop AI creation workspace with a node canvas",
  "main": "./out/main/index.js",
  "author": {
    "name": "Guo Ruifan"
  },
  "homepage": "https://github.com/wzrjlydtsq-alt/SWHB",
  "repository": {
    "type": "git",
    "url": "https://github.com/wzrjlydtsq-alt/SWHB.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "check:secrets": "node scripts/scan-secrets.cjs",
    "check:release": "node scripts/release-preflight.cjs",
    "check:release:smoke": "node scripts/release-preflight.cjs --smoke",
    "check:quality": "npm run check:secrets && npm run lint && npm run test && npm run build",
    "qa:modules": "node scripts/qa/run-module-tests.cjs",
    "qa:modules:deep": "node scripts/qa/run-module-tests.cjs --deep",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:full": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:web": "vite build --config vite.config.web.mjs",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server run test",
    "server:check": "npm --prefix server run check",
    "release": "npm run build:win && node scripts/publish-oss.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@xyflow/react": "^12.10.1",
    "ali-oss": "^6.23.0",
    "better-sqlite3": "^12.6.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.38.0",
    "iconv-lite": "^0.7.2",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.12.0",
    "marked": "^17.0.3",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "conventional-changelog-cli": "^5.0.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^28.1.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.18"
  }
}
